{
	"name": "pojodb",
	"version": "0.1.0",
	"description": "A small, typed JavaScript IndexedDB database library.",
	"keywords": [
		"browser",
		"database",
		"indexeddb",
		"key-value"
	],
	"homepage": "https://github.com/mofax/pojodb#readme",
	"bugs": {
		"url": "https://github.com/mofax/pojodb/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mofax/pojodb.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./kv": {
			"types": "./dist/kv.d.mts",
			"import": "./dist/kv.mjs"
		},
		"./database": {
			"types": "./dist/database.d.mts",
			"import": "./dist/database.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "oxfmt --check && oxlint",
		"test": "vp test run",
		"build": "vp pack",
		"prepack": "npm run build",
		"prepublishOnly": "npm run check && npm test"
	},
	"devDependencies": {
		"fake-indexeddb": "^6.2.5",
		"typescript": "^5.9.3",
		"vite-plus": "^0.1.24",
		"vitest": "^5.0.1"
	},
	"packageManager": "bun@1.4.0"
}
